#!/bin/sh
# 防止 private/ 私密目录被提交到公开主仓库（即使使用 git add -f 强制添加）
# 安装方式：cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

if git diff --cached --name-only | grep -E '^private(/|$)' >/dev/null 2>&1; then
  echo "❌ 检测到 private/ 下的文件被暂存。该目录属于私有仓库 NanoBee_Private，禁止提交到公开主仓库。"
  echo "   解除暂存：git restore --staged private/"
  exit 1
fi
